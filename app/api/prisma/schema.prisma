generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  VENDEDOR
  BODEGA
  CONTADOR
}

enum InvoiceStatus {
  ACTIVA
  ANULADA
}

model User {
  id        Int       @id @default(autoincrement())
  username  String    @unique
  password  String
  role      Role      @default(VENDEDOR)
  isActive  Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([isActive])
}

model Client {
  id             Int       @id @default(autoincrement())
  identification String    @unique
  firstName      String
  lastName       String
  phone          String?
  address        String?
  isActive       Boolean   @default(true)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  invoices       Invoice[]

  @@index([isActive])
}

model Warehouse {
  id        Int       @id @default(autoincrement())
  location  String
  isActive  Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  products  Product[]

  @@index([isActive])
}

model Product {
  id           Int           @id @default(autoincrement())
  type         String
  name         String
  description  String?
  price        Decimal       @db.Decimal(12, 2)
  taxRate      Decimal       @db.Decimal(5, 2)
  quantity     Int           @default(0)
  warehouseId  Int
  isActive     Boolean       @default(true)
  deletedAt    DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  warehouse    Warehouse     @relation(fields: [warehouseId], references: [id])
  invoiceItems InvoiceItem[]

  @@index([warehouseId])
  @@index([isActive])
}

model Invoice {
  id          Int            @id @default(autoincrement())
  consecutive String         @unique
  clientId    Int
  subtotal    Decimal        @db.Decimal(12, 2)
  taxes       Decimal        @db.Decimal(12, 2)
  total       Decimal        @db.Decimal(12, 2)
  status      InvoiceStatus  @default(ACTIVA)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  client      Client         @relation(fields: [clientId], references: [id])
  items       InvoiceItem[]

  @@index([clientId])
  @@index([status])
  @@index([createdAt])
}

model InvoiceItem {
  id        Int     @id @default(autoincrement())
  invoiceId Int
  productId Int
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)
  taxRate   Decimal @db.Decimal(5, 2)
  subtotal  Decimal @db.Decimal(12, 2)
  taxAmount Decimal @db.Decimal(12, 2)
  total     Decimal @db.Decimal(12, 2)

  invoice   Invoice @relation(fields: [invoiceId], references: [id])
  product   Product @relation(fields: [productId], references: [id])

  @@index([invoiceId])
  @@index([productId])
}