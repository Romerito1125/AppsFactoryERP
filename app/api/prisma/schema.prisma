generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int       @id @default(autoincrement())
  clientId  Int?      @unique
  username  String    @unique
  password  String
  role      Role      @default(CLIENTE)
  isActive  Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  client    Client?   @relation(fields: [clientId], references: [id])
  employee  Employee?

  @@index([isActive])
}

model Employee {
  id             Int       @id @default(autoincrement())
  userId         Int       @unique
  identification String    @unique
  firstName      String
  lastName       String
  phone          String?
  address        String?
  isActive       Boolean   @default(true)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt
  user           User      @relation(fields: [userId], references: [id])

  @@index([isActive])
}

model Client {
  id             Int           @id @default(autoincrement())
  identification String        @unique
  firstName      String
  lastName       String
  phone          String?
  address        String?
  isActive       Boolean       @default(true)
  deletedAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now()) @updatedAt
  clientType     ClientType
  invoices       Invoice[]
  offers         OfferClient[]
  user           User?
  referralCode   String?       @unique
  referralsMade  Referral[]    @relation("ReferrerClient")
  referredBy     Referral?     @relation("ReferredClient")
  referralLevel  Int           @default(0)
  quotes         Quote[]

  @@index([isActive])
}

model Referral {
  id               Int      @id @default(autoincrement())
  referrerClientId Int
  referredClientId Int      @unique
  codeUsed         String
  createdAt        DateTime @default(now())

  referrerClient Client @relation("ReferrerClient", fields: [referrerClientId], references: [id])
  referredClient Client @relation("ReferredClient", fields: [referredClientId], references: [id])

  @@index([referrerClientId])
  @@index([referredClientId])
}

model Warehouse {
  id        Int       @id @default(autoincrement())
  location  String
  isActive  Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt

  products ProductWarehouse[]

  inventoryMovementsFrom InventoryMovement[] @relation("InventoryFromWarehouse")
  inventoryMovementsTo   InventoryMovement[] @relation("InventoryToWarehouse")

  @@index([isActive])
}

model ProductType {
  id          Int                @id @default(autoincrement())
  name        String             @unique
  description String?
  isActive    Boolean            @default(true)
  deletedAt   DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @default(now()) @updatedAt
  offers      OfferProductType[]
  products    Product[]

  @@index([isActive])
}

model Product {
  id            Int       @id @default(autoincrement())
  productTypeId Int
  providerId    Int
  name          String
  description   String?
  taxRate       Decimal   @db.Decimal(5, 2)
  unit          UnitType  @default(UND)
  isActive      Boolean   @default(true)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  brand         String
  minimumStock  Int       @default(0)
  maximumStock  Int?
  imageUrl      String?

  prices             ProductPrice[]
  costs              ProductCost[]
  invoiceItems       InvoiceItem[]
  quoteItems         QuoteItem[]
  offers             OfferProduct[]
  productType        ProductType         @relation(fields: [productTypeId], references: [id])
  provider           Provider            @relation(fields: [providerId], references: [id])
  warehouses         ProductWarehouse[]
  inventoryMovements InventoryMovement[]

  tags ProductTag[]

  @@index([productTypeId])
  @@index([providerId])
  @@index([isActive])
}

model ProductWarehouse {
  productId   Int
  warehouseId Int
  quantity    Int @default(0)

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@id([productId, warehouseId])
  @@index([productId])
  @@index([warehouseId])
}

model InventoryMovement {
  id              Int                   @id @default(autoincrement())
  productId       Int
  fromWarehouseId Int?
  toWarehouseId   Int?
  quantity        Int
  movementType    InventoryMovementType
  reason          String?
  createdAt       DateTime              @default(now())

  product       Product    @relation(fields: [productId], references: [id])
  fromWarehouse Warehouse? @relation("InventoryFromWarehouse", fields: [fromWarehouseId], references: [id])
  toWarehouse   Warehouse? @relation("InventoryToWarehouse", fields: [toWarehouseId], references: [id])

  @@index([productId])
  @@index([fromWarehouseId])
  @@index([toWarehouseId])
  @@index([movementType])
  @@index([createdAt])
}

model ProductPrice {
  id        Int       @id @default(autoincrement())
  productId Int
  name      String
  price     Decimal   @db.Decimal(12, 2)
  unit      UnitType  @default(UND)
  quantity  Decimal   @default(1) @db.Decimal(12, 3)
  isDefault Boolean   @default(false)
  isActive  Boolean   @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt

  product             Product               @relation(fields: [productId], references: [id])
  invoiceItems        InvoiceItem[]
  productPriceHistory ProductPriceHistory[]
  quoteItems          QuoteItem[]

  @@index([productId])
  @@index([isActive])
}

model ProductCost {
  id        Int       @id @default(autoincrement())
  productId Int
  cost      Decimal   @db.Decimal(12, 2)
  unit      UnitType
  quantity  Decimal   @db.Decimal(12, 3)
  startsAt  DateTime  @default(now())
  endsAt    DateTime?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt

  product Product @relation(fields: [productId], references: [id])

  @@index([productId])
  @@index([isActive])
  @@index([startsAt])
}

model ProductPriceHistory {
  id             Int      @id @default(autoincrement())
  productPriceId Int
  oldPrice       Decimal  @db.Decimal(12, 2)
  newPrice       Decimal  @db.Decimal(12, 2)
  reason         String?
  createdAt      DateTime @default(now())

  productPrice ProductPrice @relation(fields: [productPriceId], references: [id])

  @@index([productPriceId])
  @@index([createdAt])
}

model Provider {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  products Product[]

  @@index([isActive])
}

model Tag {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  description String?
  isActive    Boolean      @default(true)
  deletedAt   DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @default(now()) @updatedAt
  offers      OfferTag[]
  products    ProductTag[]

  @@index([isActive])
}

model ProductTag {
  productId Int
  tagId     Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([productId])
  @@index([tagId])
}

model Invoice {
  id          Int           @id @default(autoincrement())
  consecutive String        @unique
  quoteId     Int?          @unique
  clientId    Int
  source      InvoiceSource @default(ADMIN)
  subtotal    Decimal       @db.Decimal(12, 2)
  taxes       Decimal       @db.Decimal(12, 2)
  total       Decimal       @db.Decimal(12, 2)
  status      InvoiceStatus @default(ACTIVA)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @default(now()) @updatedAt
  client      Client        @relation(fields: [clientId], references: [id])

  items        InvoiceItem[]
  quote        Quote?                @relation(fields: [quoteId], references: [id])
  delivery     Delivery?
  bankMovement BankAccountMovement[]
  credit       InvoiceCredit?

  @@index([clientId])
  @@index([status])
  @@index([createdAt])
}

model InvoiceCredit {
  id          Int          @id @default(autoincrement())
  invoiceId   Int          @unique
  dueDate     DateTime
  totalAmount Decimal      @db.Decimal(12, 2)
  paidAmount  Decimal      @default(0) @db.Decimal(12, 2)
  balance     Decimal      @db.Decimal(12, 2)
  status      CreditStatus @default(PENDIENTE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @default(now()) @updatedAt

  invoice  Invoice         @relation(fields: [invoiceId], references: [id])
  payments CreditPayment[]

  @@index([dueDate])
  @@index([status])
}

model CreditPayment {
  id              Int      @id @default(autoincrement())
  invoiceCreditId Int
  bankMovementId  Int?
  amount          Decimal  @db.Decimal(12, 2)
  paidAt          DateTime @default(now())
  notes           String?

  invoiceCredit InvoiceCredit        @relation(fields: [invoiceCreditId], references: [id])
  bankMovement  BankAccountMovement? @relation(fields: [bankMovementId], references: [id])

  @@index([invoiceCreditId])
  @@index([bankMovementId])
  @@index([paidAt])
}

model Delivery {
  id             Int            @id @default(autoincrement())
  invoiceId      Int            @unique
  address        String
  recipientName  String
  recipientPhone String
  notes          String?
  status         DeliveryStatus @default(PENDIENTE)
  deliveredAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @default(now()) @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([status])
  @@index([createdAt])
}

model InvoiceItem {
  id             Int     @id @default(autoincrement())
  invoiceId      Int
  productId      Int
  productPriceId Int?
  quantity       Int
  unitPrice      Decimal @db.Decimal(12, 2)
  taxRate        Decimal @db.Decimal(5, 2)
  subtotal       Decimal @db.Decimal(12, 2)
  taxAmount      Decimal @db.Decimal(12, 2)
  total          Decimal @db.Decimal(12, 2)

  invoice      Invoice       @relation(fields: [invoiceId], references: [id])
  product      Product       @relation(fields: [productId], references: [id])
  productPrice ProductPrice? @relation(fields: [productPriceId], references: [id])

  @@index([invoiceId])
  @@index([productId])
  @@index([productPriceId])
}

model Offer {
  id            Int          @id @default(autoincrement())
  name          String
  description   String?
  discountType  DiscountType
  discountValue Decimal      @db.Decimal(12, 2)

  startsAt DateTime?
  endsAt   DateTime?

  minimumProductQuantity Int?
  maximumProductQuantity Int?

  isActive  Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt

  isStackable  Boolean            @default(false)
  clients      OfferClient[]
  products     OfferProduct[]
  productTypes OfferProductType[]
  tags         OfferTag[]

  @@index([isActive])
  @@index([startsAt])
  @@index([endsAt])
}

model OfferClient {
  offerId  Int
  clientId Int
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  offer    Offer  @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@id([offerId, clientId])
  @@index([offerId])
  @@index([clientId])
}

model OfferProduct {
  offerId   Int
  productId Int
  offer     Offer   @relation(fields: [offerId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([offerId, productId])
  @@index([offerId])
  @@index([productId])
}

model OfferProductType {
  offerId       Int
  productTypeId Int
  offer         Offer       @relation(fields: [offerId], references: [id], onDelete: Cascade)
  productType   ProductType @relation(fields: [productTypeId], references: [id], onDelete: Cascade)

  @@id([offerId, productTypeId])
  @@index([offerId])
  @@index([productTypeId])
}

model OfferTag {
  offerId Int
  tagId   Int
  offer   Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  tag     Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([offerId, tagId])
  @@index([offerId])
  @@index([tagId])
}

model BankAccount {
  id             Int       @id @default(autoincrement())
  name           String
  bankName       String
  accountNumber  String?
  accountType    String?
  currentBalance Decimal   @default(0) @db.Decimal(14, 2)
  isActive       Boolean   @default(true)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt

  movements BankAccountMovement[]

  @@index([isActive])
}

model BankAccountMovement {
  id            Int              @id @default(autoincrement())
  bankAccountId Int
  movementType  BankMovementType
  amount        Decimal          @db.Decimal(14, 2)
  description   String?
  invoiceId     Int?             @unique
  createdAt     DateTime         @default(now())

  bankAccount    BankAccount     @relation(fields: [bankAccountId], references: [id])
  invoice        Invoice?        @relation(fields: [invoiceId], references: [id])
  creditPayments CreditPayment[]

  @@index([bankAccountId])
  @@index([movementType])
  @@index([invoiceId])
  @@index([createdAt])
}

model Quote {
  id          Int         @id @default(autoincrement())
  consecutive String      @unique
  clientId    Int
  subtotal    Decimal     @db.Decimal(12, 2)
  taxes       Decimal     @db.Decimal(12, 2)
  total       Decimal     @db.Decimal(12, 2)
  status      QuoteStatus @default(PENDIENTE)
  expiresAt   DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @default(now()) @updatedAt

  client  Client      @relation(fields: [clientId], references: [id])
  items   QuoteItem[]
  invoice Invoice?

  @@index([clientId])
  @@index([status])
  @@index([expiresAt])
}

model QuoteItem {
  id             Int     @id @default(autoincrement())
  quoteId        Int
  productId      Int
  productPriceId Int?
  quantity       Int
  unitPrice      Decimal @db.Decimal(12, 2)
  taxRate        Decimal @db.Decimal(5, 2)
  subtotal       Decimal @db.Decimal(12, 2)
  taxAmount      Decimal @db.Decimal(12, 2)
  total          Decimal @db.Decimal(12, 2)

  quote        Quote         @relation(fields: [quoteId], references: [id])
  product      Product       @relation(fields: [productId], references: [id])
  productPrice ProductPrice? @relation(fields: [productPriceId], references: [id])

  @@index([quoteId])
  @@index([productId])
  @@index([productPriceId])
}

enum QuoteStatus {
  PENDIENTE
  APROBADA
  RECHAZADA
  CONVERTIDA
  EXPIRADA
}

enum Role {
  CLIENTE
  ADMIN
  VENDEDOR
  BODEGA
  CONTADOR
}

enum ClientType {
  MAYORISTA
  MINORISTA
}

enum InvoiceStatus {
  ACTIVA
  ANULADA
}

enum InvoiceSource {
  ADMIN
  POS
  APP_MOVIL
}

enum DiscountType {
  PORCENTAJE
  MONTO_FIJO
}

enum DeliveryStatus {
  PENDIENTE
  EN_PREPARACION
  EN_CAMINO
  ENTREGADO
  CANCELADO
}

enum InventoryMovementType {
  ENTRADA
  SALIDA
  TRASLADO
  AJUSTE
  DEVOLUCION
}

enum BankMovementType {
  INGRESO
  EGRESO
  TRANSFERENCIA_ENTRANTE
  TRANSFERENCIA_SALIENTE
  AJUSTE
}

enum UnitType {
  UND
  KG
  G
  LB
  L
  ML
  CAJA
  PAQUETE
}

enum CreditStatus {
  PENDIENTE
  PARCIAL
  PAGADA
  VENCIDA
  CANCELADA
}
