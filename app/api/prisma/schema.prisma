generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int       @id @default(autoincrement())
  username  String    @unique
  password  String
  role      Role      @default(VENDEDOR)
  isActive  Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt

  @@index([isActive])
}

model Client {
  id             Int           @id @default(autoincrement())
  identification String        @unique
  firstName      String
  lastName       String
  phone          String?
  address        String?
  isActive       Boolean       @default(true)
  deletedAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now()) @updatedAt
  invoices       Invoice[]
  offers         OfferClient[]

  @@index([isActive])
}

model Warehouse {
  id        Int       @id @default(autoincrement())
  location  String
  isActive  Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  products  Product[]

  @@index([isActive])
}

model ProductType {
  id          Int                @id @default(autoincrement())
  name        String             @unique
  description String?
  isActive    Boolean            @default(true)
  deletedAt   DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @default(now()) @updatedAt
  offers      OfferProductType[]
  products    Product[]

  @@index([isActive])
}

model Product {
  id            Int            @id @default(autoincrement())
  productTypeId Int
  name          String
  description   String?
  price         Decimal        @db.Decimal(12, 2)
  taxRate       Decimal        @db.Decimal(5, 2)
  quantity      Int            @default(0)
  warehouseId   Int
  isActive      Boolean        @default(true)
  deletedAt     DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @default(now()) @updatedAt
  invoiceItems  InvoiceItem[]
  offers        OfferProduct[]
  productType   ProductType    @relation(fields: [productTypeId], references: [id])
  warehouse     Warehouse      @relation(fields: [warehouseId], references: [id])
  tags          ProductTag[]

  @@index([productTypeId])
  @@index([warehouseId])
  @@index([isActive])
}

model Tag {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  description String?
  isActive    Boolean      @default(true)
  deletedAt   DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @default(now()) @updatedAt
  offers      OfferTag[]
  products    ProductTag[]

  @@index([isActive])
}

model ProductTag {
  productId Int
  tagId     Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([productId])
  @@index([tagId])
}

model Invoice {
  id          Int           @id @default(autoincrement())
  consecutive String        @unique
  clientId    Int
  subtotal    Decimal       @db.Decimal(12, 2)
  taxes       Decimal       @db.Decimal(12, 2)
  total       Decimal       @db.Decimal(12, 2)
  status      InvoiceStatus @default(ACTIVA)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @default(now()) @updatedAt
  client      Client        @relation(fields: [clientId], references: [id])
  items       InvoiceItem[]

  @@index([clientId])
  @@index([status])
  @@index([createdAt])
}

model InvoiceItem {
  id        Int     @id @default(autoincrement())
  invoiceId Int
  productId Int
  quantity  Int
  unitPrice Decimal @db.Decimal(12, 2)
  taxRate   Decimal @db.Decimal(5, 2)
  subtotal  Decimal @db.Decimal(12, 2)
  taxAmount Decimal @db.Decimal(12, 2)
  total     Decimal @db.Decimal(12, 2)
  invoice   Invoice @relation(fields: [invoiceId], references: [id])
  product   Product @relation(fields: [productId], references: [id])

  @@index([invoiceId])
  @@index([productId])
}

model Offer {
  id            Int                @id @default(autoincrement())
  name          String
  description   String?
  discountType  DiscountType
  discountValue Decimal            @db.Decimal(12, 2)
  startsAt      DateTime?
  endsAt        DateTime?
  isActive      Boolean            @default(true)
  deletedAt     DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @default(now()) @updatedAt
  clients       OfferClient[]
  products      OfferProduct[]
  productTypes  OfferProductType[]
  tags          OfferTag[]

  @@index([isActive])
  @@index([startsAt])
  @@index([endsAt])
}

model OfferClient {
  offerId  Int
  clientId Int
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  offer    Offer  @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@id([offerId, clientId])
  @@index([offerId])
  @@index([clientId])
}

model OfferProduct {
  offerId   Int
  productId Int
  offer     Offer   @relation(fields: [offerId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([offerId, productId])
  @@index([offerId])
  @@index([productId])
}

model OfferProductType {
  offerId       Int
  productTypeId Int
  offer         Offer       @relation(fields: [offerId], references: [id], onDelete: Cascade)
  productType   ProductType @relation(fields: [productTypeId], references: [id], onDelete: Cascade)

  @@id([offerId, productTypeId])
  @@index([offerId])
  @@index([productTypeId])
}

model OfferTag {
  offerId Int
  tagId   Int
  offer   Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  tag     Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([offerId, tagId])
  @@index([offerId])
  @@index([tagId])
}

enum Role {
  ADMIN
  VENDEDOR
  BODEGA
  CONTADOR
}

enum InvoiceStatus {
  ACTIVA
  ANULADA
}

enum DiscountType {
  PORCENTAJE
  MONTO_FIJO
}
