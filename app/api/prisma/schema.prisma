generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              Int       @id @default(autoincrement())
  clientId        Int?      @unique
  username        String    @unique
  password        String
  role            Role      @default(CLIENTE)
  isActive        Boolean   @default(true)
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt
  client          Client?   @relation(fields: [clientId], references: [id])
  employee        Employee?
  createdInvoices Invoice[] @relation("InvoiceCreatedBy")
  favoriteProducts ProductFavorite[]

  @@index([isActive])
}

model Employee {
  id             Int       @id @default(autoincrement())
  userId         Int       @unique
  identification String    @unique
  firstName      String
  lastName       String
  phone          String?
  address        String?
  isActive       Boolean   @default(true)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt
  user           User      @relation(fields: [userId], references: [id])

  @@index([isActive])
}

model Client {
  id             Int           @id @default(autoincrement())
  identification String        @unique
  firstName      String
  lastName       String
  phone          String?
  address        String?
  isActive       Boolean       @default(true)
  deletedAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now()) @updatedAt
  clientType     ClientType
  invoices       Invoice[]
  offers         OfferClient[]
  user           User?
  referralCode   String?       @unique
  referralsMade  Referral[]    @relation("ReferrerClient")
  referredBy     Referral?     @relation("ReferredClient")
  referralLevel  Int           @default(0)
  quotes         Quote[]
  referralBenefits ReferralBenefit[] @relation("BenefitRecipient")
  generatedReferralBenefits ReferralBenefit[] @relation("BenefitBuyer")

  @@index([isActive])
}

model Referral {
  id               Int      @id @default(autoincrement())
  referrerClientId Int
  referredClientId Int      @unique
  codeUsed         String
  createdAt        DateTime @default(now())

  referrerClient Client @relation("ReferrerClient", fields: [referrerClientId], references: [id])
  referredClient Client @relation("ReferredClient", fields: [referredClientId], references: [id])

  @@index([referrerClientId])
  @@index([referredClientId])
}

model Warehouse {
  id        Int       @id @default(autoincrement())
  location  String
  isActive  Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt

  products ProductWarehouse[]

  inventoryMovementsFrom InventoryMovement[] @relation("InventoryFromWarehouse")
  inventoryMovementsTo   InventoryMovement[] @relation("InventoryToWarehouse")
  purchaseOrders         PurchaseOrder[]

  @@index([isActive])
}

model ProductType {
  id          Int                @id @default(autoincrement())
  name        String             @unique
  description String?
  isActive    Boolean            @default(true)
  deletedAt   DateTime?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @default(now()) @updatedAt
  offers      OfferProductType[]
  products    Product[]

  @@index([isActive])
}

model Product {
  id            Int       @id @default(autoincrement())
  productTypeId Int
  providerId    Int
  name          String
  description   String?
  taxRate       Decimal   @db.Decimal(5, 2)
  unit          UnitType  @default(UND)
  isActive      Boolean   @default(true)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @default(now()) @updatedAt
  brand         String
  minimumStock  Int       @default(0)
  maximumStock  Int?
  imageUrl      String?

  prices             ProductPrice[]
  costs              ProductCost[]
  invoiceItems       InvoiceItem[]
  quoteItems         QuoteItem[]
  offers             OfferProduct[]
  productType        ProductType         @relation(fields: [productTypeId], references: [id])
  primaryProvider    Provider            @relation("PrimaryProductProvider", fields: [providerId], references: [id])
  providers          ProductProvider[]
  warehouses         ProductWarehouse[]
  inventoryMovements InventoryMovement[]
  barcodes           ProductBarcode[]
  favoriteUsers      ProductFavorite[]
  purchaseOrderItems PurchaseOrderItem[]

  tags ProductTag[]

  @@index([productTypeId])
  @@index([providerId])
  @@index([isActive])
}

model ProductProvider {
  productId  Int
  providerId Int
  createdAt  DateTime @default(now())

  product  Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  provider Provider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@id([productId, providerId])
  @@index([productId])
  @@index([providerId])
}

model ProductBarcode {
  id        Int          @id @default(autoincrement())
  productId Int
  code      String       @unique
  type      BarcodeType?
  isPrimary Boolean      @default(false)
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @default(now()) @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([isActive])
}

model ProductWarehouse {
  productId   Int
  warehouseId Int
  quantity    Int @default(0)

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@id([productId, warehouseId])
  @@index([productId])
  @@index([warehouseId])
}

model InventoryMovement {
  id              Int                   @id @default(autoincrement())
  productId       Int
  fromWarehouseId Int?
  toWarehouseId   Int?
  quantity        Int
  movementType    InventoryMovementType
  reason          String?
  createdAt       DateTime              @default(now())
  purchaseOrderItemId Int?

  product       Product    @relation(fields: [productId], references: [id])
  fromWarehouse Warehouse? @relation("InventoryFromWarehouse", fields: [fromWarehouseId], references: [id])
  toWarehouse   Warehouse? @relation("InventoryToWarehouse", fields: [toWarehouseId], references: [id])
  purchaseOrderItem PurchaseOrderItem? @relation(fields: [purchaseOrderItemId], references: [id])

  @@index([productId])
  @@index([fromWarehouseId])
  @@index([toWarehouseId])
  @@index([movementType])
  @@index([createdAt])
  @@index([purchaseOrderItemId])
}

model ProductPrice {
  id        Int       @id @default(autoincrement())
  productId Int
  name      String
  price     Decimal   @db.Decimal(12, 2)
  unit      UnitType  @default(UND)
  quantity  Decimal   @default(1) @db.Decimal(12, 3)
  isDefault Boolean   @default(false)
  isActive  Boolean   @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt

  product             Product               @relation(fields: [productId], references: [id])
  invoiceItems        InvoiceItem[]
  productPriceHistory ProductPriceHistory[]
  quoteItems          QuoteItem[]

  @@index([productId])
  @@index([isActive])
}

model ProductCost {
  id        Int       @id @default(autoincrement())
  productId Int
  cost      Decimal   @db.Decimal(12, 2)
  unit      UnitType
  quantity  Decimal   @db.Decimal(12, 3)
  startsAt  DateTime  @default(now())
  endsAt    DateTime?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  purchaseOrderItemId Int?

  product Product @relation(fields: [productId], references: [id])
  purchaseOrderItem PurchaseOrderItem? @relation(fields: [purchaseOrderItemId], references: [id])

  @@index([productId])
  @@index([isActive])
  @@index([startsAt])
  @@index([purchaseOrderItemId])
}

model ProductPriceHistory {
  id             Int      @id @default(autoincrement())
  productPriceId Int
  oldPrice       Decimal  @db.Decimal(12, 2)
  newPrice       Decimal  @db.Decimal(12, 2)
  reason         String?
  createdAt      DateTime @default(now())

  productPrice ProductPrice @relation(fields: [productPriceId], references: [id])

  @@index([productPriceId])
  @@index([createdAt])
}

model Provider {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  description String?
  isActive    Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  primaryProducts Product[]         @relation("PrimaryProductProvider")
  productLinks    ProductProvider[]
  purchaseOrders PurchaseOrder[]

  @@index([isActive])
}

model Tag {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  description String?
  isActive    Boolean      @default(true)
  deletedAt   DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @default(now()) @updatedAt
  offers      OfferTag[]
  products    ProductTag[]

  @@index([isActive])
}

model ProductTag {
  productId Int
  tagId     Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([productId, tagId])
  @@index([productId])
  @@index([tagId])
}

model Invoice {
  id                Int           @id @default(autoincrement())
  consecutive       String        @unique
  quoteId           Int?          @unique
  clientId          Int
  createdByUserId   Int?
  createdByRole     Role?
  createdByUsername String?
  source            InvoiceSource @default(ADMIN)
  subtotal          Decimal       @db.Decimal(12, 2)
  taxes             Decimal       @db.Decimal(12, 2)
  total             Decimal       @db.Decimal(12, 2)
  discountTotal     Decimal       @default(0) @db.Decimal(12, 2)
  referralDiscount Decimal       @default(0) @db.Decimal(12, 2)
  status            InvoiceStatus @default(ACTIVA)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @default(now()) @updatedAt
  client            Client        @relation(fields: [clientId], references: [id])
  createdByUser     User?         @relation("InvoiceCreatedBy", fields: [createdByUserId], references: [id])

  items         InvoiceItem[]
  quote         Quote?                @relation(fields: [quoteId], references: [id])
  delivery      Delivery?
  bankMovement  BankAccountMovement[]
  credit        InvoiceCredit?
  notifications Notification[]
  generatedReferralBenefits ReferralBenefit[]
  benefitRedemptions ReferralBenefitRedemption[]

  @@index([clientId])
  @@index([createdByUserId])
  @@index([createdByRole])
  @@index([status])
  @@index([createdAt])
}

model Notification {
  id        Int              @id @default(autoincrement())
  type      NotificationType
  title     String
  message   String
  source    InvoiceSource?
  invoiceId Int?
  createdAt DateTime         @default(now())

  invoice Invoice? @relation(fields: [invoiceId], references: [id])

  @@index([type])
  @@index([source])
  @@index([invoiceId])
  @@index([createdAt])
}

model InvoiceCredit {
  id          Int          @id @default(autoincrement())
  invoiceId   Int          @unique
  dueDate     DateTime
  totalAmount Decimal      @db.Decimal(12, 2)
  paidAmount  Decimal      @default(0) @db.Decimal(12, 2)
  balance     Decimal      @db.Decimal(12, 2)
  status      CreditStatus @default(PENDIENTE)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @default(now()) @updatedAt

  invoice  Invoice         @relation(fields: [invoiceId], references: [id])
  payments CreditPayment[]

  @@index([dueDate])
  @@index([status])
}

model CreditPayment {
  id              Int      @id @default(autoincrement())
  invoiceCreditId Int
  bankMovementId  Int?
  amount          Decimal  @db.Decimal(12, 2)
  paidAt          DateTime @default(now())
  notes           String?

  invoiceCredit InvoiceCredit        @relation(fields: [invoiceCreditId], references: [id])
  bankMovement  BankAccountMovement? @relation(fields: [bankMovementId], references: [id])

  @@index([invoiceCreditId])
  @@index([bankMovementId])
  @@index([paidAt])
}

model Delivery {
  id             Int            @id @default(autoincrement())
  invoiceId      Int            @unique
  address        String
  recipientName  String
  recipientPhone String
  notes          String?
  status         DeliveryStatus @default(PENDIENTE)
  deliveredAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @default(now()) @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([status])
  @@index([createdAt])
}

model InvoiceItem {
  id             Int     @id @default(autoincrement())
  invoiceId      Int
  productId      Int
  productPriceId Int?
  quantity       Int
  unitPrice      Decimal @db.Decimal(12, 2)
  taxRate        Decimal @db.Decimal(5, 2)
  subtotal       Decimal @db.Decimal(12, 2)
  taxAmount      Decimal @db.Decimal(12, 2)
  total          Decimal @db.Decimal(12, 2)
  grossSubtotal  Decimal @default(0) @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  unitCost       Decimal? @db.Decimal(12, 2)
  profitAmount   Decimal? @db.Decimal(12, 2)

  invoice      Invoice       @relation(fields: [invoiceId], references: [id])
  product      Product       @relation(fields: [productId], references: [id])
  productPrice ProductPrice? @relation(fields: [productPriceId], references: [id])

  @@index([invoiceId])
  @@index([productId])
  @@index([productPriceId])
}

model ProductFavorite {
  userId    Int
  productId Int
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([userId, productId])
  @@index([productId])
}

model ReferralProfitPolicy {
  id         Int      @id @default(autoincrement())
  generation Int      @unique
  percentage Decimal  @db.Decimal(5, 2)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @default(now()) @updatedAt

  @@index([isActive])
}

model ReferralBenefit {
  id                  Int                   @id @default(autoincrement())
  beneficiaryClientId Int
  buyerClientId       Int
  originInvoiceId     Int
  generation          Int
  baseProfit          Decimal               @db.Decimal(12, 2)
  percentage          Decimal               @db.Decimal(5, 2)
  amount              Decimal               @db.Decimal(12, 2)
  remainingAmount     Decimal               @db.Decimal(12, 2)
  status              ReferralBenefitStatus @default(DISPONIBLE)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @default(now()) @updatedAt

  beneficiary Client @relation("BenefitRecipient", fields: [beneficiaryClientId], references: [id])
  buyer       Client @relation("BenefitBuyer", fields: [buyerClientId], references: [id])
  originInvoice Invoice @relation(fields: [originInvoiceId], references: [id])
  redemptions ReferralBenefitRedemption[]

  @@unique([beneficiaryClientId, originInvoiceId, generation])
  @@index([beneficiaryClientId, status])
  @@index([buyerClientId])
  @@index([originInvoiceId])
}

model ReferralBenefitRedemption {
  id        Int      @id @default(autoincrement())
  benefitId Int
  invoiceId Int
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  benefit ReferralBenefit @relation(fields: [benefitId], references: [id])
  invoice Invoice         @relation(fields: [invoiceId], references: [id])

  @@index([benefitId])
  @@index([invoiceId])
}

model PurchaseOrder {
  id                Int                 @id @default(autoincrement())
  consecutive       String              @unique
  providerId        Int
  warehouseId       Int
  status            PurchaseOrderStatus @default(BORRADOR)
  externalReference String?
  notes             String?
  orderedAt         DateTime             @default(now())
  expectedAt        DateTime?
  receivedAt        DateTime?
  subtotal          Decimal              @db.Decimal(14, 2)
  taxes             Decimal              @db.Decimal(14, 2)
  total             Decimal              @db.Decimal(14, 2)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @default(now()) @updatedAt

  provider  Provider            @relation(fields: [providerId], references: [id])
  warehouse Warehouse           @relation(fields: [warehouseId], references: [id])
  items     PurchaseOrderItem[]

  @@index([providerId])
  @@index([warehouseId])
  @@index([status])
  @@index([orderedAt])
}

model PurchaseOrderItem {
  id                 Int      @id @default(autoincrement())
  purchaseOrderId    Int
  productId          Int
  quantity           Int
  receivedQuantity   Int      @default(0)
  unit                UnitType @default(UND)
  unitCost            Decimal  @db.Decimal(12, 2)
  taxRate             Decimal  @default(0) @db.Decimal(5, 2)
  subtotal            Decimal  @db.Decimal(14, 2)
  taxAmount           Decimal  @db.Decimal(14, 2)
  total               Decimal  @db.Decimal(14, 2)

  purchaseOrder     PurchaseOrder       @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  product           Product             @relation(fields: [productId], references: [id])
  inventoryMovements InventoryMovement[]
  productCosts       ProductCost[]

  @@index([purchaseOrderId])
  @@index([productId])
}

model Offer {
  id            Int          @id @default(autoincrement())
  name          String
  description   String?
  discountType  DiscountType
  discountValue Decimal      @db.Decimal(12, 2)

  startsAt DateTime?
  endsAt   DateTime?

  minimumProductQuantity Int?
  maximumProductQuantity Int?

  isActive  Boolean   @default(true)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt

  isStackable  Boolean            @default(false)
  clients      OfferClient[]
  products     OfferProduct[]
  productTypes OfferProductType[]
  tags         OfferTag[]

  @@index([isActive])
  @@index([startsAt])
  @@index([endsAt])
}

model OfferClient {
  offerId  Int
  clientId Int
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  offer    Offer  @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@id([offerId, clientId])
  @@index([offerId])
  @@index([clientId])
}

model OfferProduct {
  offerId   Int
  productId Int
  offer     Offer   @relation(fields: [offerId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([offerId, productId])
  @@index([offerId])
  @@index([productId])
}

model OfferProductType {
  offerId       Int
  productTypeId Int
  offer         Offer       @relation(fields: [offerId], references: [id], onDelete: Cascade)
  productType   ProductType @relation(fields: [productTypeId], references: [id], onDelete: Cascade)

  @@id([offerId, productTypeId])
  @@index([offerId])
  @@index([productTypeId])
}

model OfferTag {
  offerId Int
  tagId   Int
  offer   Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  tag     Tag   @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([offerId, tagId])
  @@index([offerId])
  @@index([tagId])
}

model BankAccount {
  id             Int       @id @default(autoincrement())
  name           String
  bankName       String
  accountNumber  String?
  accountType    String?
  currentBalance Decimal   @default(0) @db.Decimal(14, 2)
  isActive       Boolean   @default(true)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt

  movements BankAccountMovement[]

  @@index([isActive])
}

model BankAccountMovement {
  id            Int              @id @default(autoincrement())
  bankAccountId Int
  movementType  BankMovementType
  amount        Decimal          @db.Decimal(14, 2)
  description   String?
  invoiceId     Int?             @unique
  createdAt     DateTime         @default(now())

  bankAccount    BankAccount     @relation(fields: [bankAccountId], references: [id])
  invoice        Invoice?        @relation(fields: [invoiceId], references: [id])
  creditPayments CreditPayment[]

  @@index([bankAccountId])
  @@index([movementType])
  @@index([invoiceId])
  @@index([createdAt])
}

model Quote {
  id          Int         @id @default(autoincrement())
  consecutive String      @unique
  clientId    Int
  subtotal    Decimal     @db.Decimal(12, 2)
  taxes       Decimal     @db.Decimal(12, 2)
  total       Decimal     @db.Decimal(12, 2)
  status      QuoteStatus @default(PENDIENTE)
  expiresAt   DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @default(now()) @updatedAt

  client  Client      @relation(fields: [clientId], references: [id])
  items   QuoteItem[]
  invoice Invoice?

  @@index([clientId])
  @@index([status])
  @@index([expiresAt])
}

model QuoteItem {
  id             Int     @id @default(autoincrement())
  quoteId        Int
  productId      Int
  productPriceId Int?
  quantity       Int
  unitPrice      Decimal @db.Decimal(12, 2)
  taxRate        Decimal @db.Decimal(5, 2)
  subtotal       Decimal @db.Decimal(12, 2)
  taxAmount      Decimal @db.Decimal(12, 2)
  total          Decimal @db.Decimal(12, 2)

  quote        Quote         @relation(fields: [quoteId], references: [id])
  product      Product       @relation(fields: [productId], references: [id])
  productPrice ProductPrice? @relation(fields: [productPriceId], references: [id])

  @@index([quoteId])
  @@index([productId])
  @@index([productPriceId])
}

enum QuoteStatus {
  PENDIENTE
  APROBADA
  RECHAZADA
  CONVERTIDA
  EXPIRADA
}

enum Role {
  CLIENTE
  ADMIN
  CAJERO
  VENDEDOR
  BODEGA
  CONTADOR
}

enum NotificationType {
  FACTURA
  VENTA_POS
  PEDIDO_APP
}

enum ClientType {
  MAYORISTA
  MINORISTA
}

enum InvoiceStatus {
  ACTIVA
  ANULADA
}

enum InvoiceSource {
  ADMIN
  POS
  APP_MOVIL
}

enum DiscountType {
  PORCENTAJE
  MONTO_FIJO
}

enum DeliveryStatus {
  PENDIENTE
  EN_PREPARACION
  EN_CAMINO
  ENTREGADO
  CANCELADO
}

enum InventoryMovementType {
  ENTRADA
  SALIDA
  TRASLADO
  AJUSTE
  DEVOLUCION
}

enum BankMovementType {
  INGRESO
  EGRESO
  TRANSFERENCIA_ENTRANTE
  TRANSFERENCIA_SALIENTE
  AJUSTE
}

enum UnitType {
  UND
  KG
  G
  LB
  L
  ML
  CAJA
  PAQUETE
}

enum BarcodeType {
  EAN13
  EAN8
  UPC_A
  UPC_E
  CODE128
  QR
  OTHER
}

enum CreditStatus {
  PENDIENTE
  PARCIAL
  PAGADA
  VENCIDA
  CANCELADA
}

enum ReferralBenefitStatus {
  DISPONIBLE
  USADO
  ANULADO
}

enum PurchaseOrderStatus {
  BORRADOR
  ORDENADA
  RECIBIDA
  ANULADA
}
