{
  "name": "api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "prisma:generate": "bun scripts/prisma-node-cli.js generate --schema prisma/schema.prisma",
    "dev": "bun run prisma:generate && bun -e \"const fs=require('node:fs'); fs.rmSync('dist',{ recursive:true, force:true }); fs.rmSync('tsconfig.build.tsbuildinfo',{ force:true });\" && nest start --watch",
    "build": "bun run prisma:generate && bun -e \"const fs=require('node:fs'); fs.rmSync('dist',{ recursive:true, force:true }); fs.rmSync('tsconfig.build.tsbuildinfo',{ force:true });\" && nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "bun run prisma:generate && bun -e \"const fs=require('node:fs'); fs.rmSync('dist',{ recursive:true, force:true }); fs.rmSync('tsconfig.build.tsbuildinfo',{ force:true });\" && nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "bun dist/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:api-contracts": "bun scripts/test-api-contracts.ts",
    "test:erp-endpoints": "bun scripts/test-erp-endpoints.ts",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "db:generate": "bun scripts/prisma-node-cli.js generate --schema prisma/schema.prisma",
    "db:migrate": "bun scripts/prisma-node-cli.js migrate dev --schema prisma/schema.prisma",
    "db:deploy": "bun scripts/prisma-node-cli.js migrate deploy --schema prisma/schema.prisma",
    "db:seed:full-demo": "bun run db:seed:quick-access && bun run db:seed:business-examples && bun run db:seed:product-type-images",
    "db:seed:quick-access": "bun scripts/seed-quick-access-and-mobile-orders.js",
    "db:seed:barcode-examples": "bun scripts/seed-product-barcode-examples.js",
    "db:seed:business-examples": "bun scripts/seed-business-examples.js",
    "db:seed:product-type-images": "bun scripts/fill-product-type-images.js",
    "db:seed:fix-demo-product-images": "bun scripts/fix-demo-product-images.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1074.0",
    "@aws-sdk/s3-request-presigner": "^3.1074.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.0.10",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^17.4.2",
    "joi": "^18.2.1",
    "multer": "^2.2.0",
    "pg": "^8.21.0",
    "prisma": "^7.8.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.17.1",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.17",
    "@types/supertest": "^7.0.0",
    "ajv": "^8.17.1",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^17.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
