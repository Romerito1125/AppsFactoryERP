PORT=3000
DATABASE_URL="postgresql://user:password@localhost:5432/app"
RESEND_API_KEY="re_xxxxxxxxx"
RESEND_FROM_EMAIL="reportes@tudominio.com"
RESEND_REPLY_TO_EMAIL="contabilidad@tudominio.com"
CLOUDFLARE_R2_ACCOUNT_ID=""
CLOUDFLARE_R2_ACCESS_KEY_ID=""
CLOUDFLARE_R2_SECRET_ACCESS_KEY=""
CLOUDFLARE_R2_BUCKET=""
CLOUDFLARE_R2_PUBLIC_URL="https://pub-example.r2.dev"

# Mundi (asistente IA). Pon tu key real solo en .env, nunca en este archivo.
OPENAI_API_KEY=""
# Id del modelo. "gpt-5.3-luna" es el pedido; si tu cuenta no lo tiene, usa el que indique la consola de OpenAI.
OPENAI_MODEL="gpt-5.3-luna"
# none | minimal | low | medium | high | xhigh
OPENAI_REASONING_EFFORT="high"
# Pasos máximos (llamadas a herramientas) por respuesta.
MUNDI_MAX_TURNS=20
# true para enviar trazas a OpenAI (por defecto desactivado: los datos del negocio no salen).
MUNDI_TRACING=false
